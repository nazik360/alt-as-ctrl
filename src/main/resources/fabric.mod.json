{
	"schemaVersion": 1,
	"id": "alt-as-ctrl",
	"version": "${version}",
	"name": "Alt as Ctrl",
	"description": "Moves Ctrl interactions (Ctrl+Q drop stack, Ctrl+click, Ctrl+A/C/V) to Alt. Client-side only: other players do not need the mod.",
	"authors": [
		"you"
	],
	"license": "CC0-1.0",
	"icon": "assets/alt-as-ctrl/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.example.client.AltAsCtrlClient"
		]
	},
	"mixins": [
		{
			"config": "alt-as-ctrl.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.14.21",
		"minecraft": "1.19.2",
		"java": ">=17",
		"fabric-api": "*"
	}
}
